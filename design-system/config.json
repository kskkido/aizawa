{
  "source": ["design-system/tokens/**/*.json"],
  "platforms": {
    "scss": {
      "transformGroup": "scss",
      "buildPath": "design-system/build/scss/",
      "files": [
        {
          "destination": "_tokens.scss",
          "format": "scss/map-deep"
        }
      ]
    },
    "js": {
      "transformGroup": "js",
      "buildPath": "design-system/build/js/",
      "files": [
        {
          "destination": "tokens.js",
          "format": "javascript/es6"
        }
      ]
    }
  }
}
