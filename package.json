{
  "name": "aizawa",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@aizawa/web --filter=@aizawa/studio",
    "deploy": "turbo run deploy",
    "typegen": "turbo run typegen",
    "check": "biome check",
    "check:fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "turbo": "^2.11.10"
  }
}
