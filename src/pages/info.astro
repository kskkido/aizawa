---
import Image from "@/components/Image.astro";
import PortableText from "@/components/PortableText.astro";
import Layout from "@/layouts/Layout.astro";
import * as contents from "@/lib/contents";

const { result: profile } = await contents.getProfile();
---

<Layout title="Info">
  <article class="info">
    <figure>
      <Image
        image={profile.image}
        width={640}
        widths={[320, 480, 640, 800, 960]}
        sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, (max-width: 1280px) 33vw, 25vw"
        fetchpriority="high"
      />
      {profile.image.caption && (<figcaption>
        <PortableText portableText={profile.image.caption} />
      </figcaption>)}
    </figure>
    <div>
      <PortableText portableText={profile.content} />
    </div>
  </article>
</Layout>
