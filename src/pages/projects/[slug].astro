---
import Card from "@/components/Card.astro";
import Image from "@/components/Image.astro";
import PortableText from "@/components/PortableText.astro";
import Video from "@/components/Video.astro";
import Layout from "@/layouts/Layout.astro";
import * as contents from "@/lib/contents";

const CARD_IMAGE_WIDTHS = [320, 640, 800, 960, 1280, 1600];
const CARD_IMAGE_SIZES =
  "(max-width: 720px) 100vw, (max-width: 960px) 50vw, (max-width: 1280px) 33vw, 25vw";

export async function getStaticPaths() {
  const { result: projects } = await contents.getProjects();

  return projects.items.map(({ slug }) => {
    return {
      params: {
        slug: slug.current,
      },
    };
  });
}

const { params } = Astro;

const { result: project } = await contents.getProject(params.slug);
const { result: previousProject } = await contents.getPreviousProject(
  project._id,
);
const { result: nextProject } = await contents.getNextProject(project._id);
---

<Layout
  title={project.title}
  image={project.image}
>
  <article
    class="project"
    data-slug={project.slug.current}
    data-component="project"
  >
    <aside>
      <header class="stack stack-sm">
        <h1>{project.title}</h1>
        <span>{project.subtitle}</span>
      </header>
      <div>
        <PortableText portableText={project.content} />
      </div>
    </aside>
    <main>
      <ul class="stack">
        {project.rows.map((row, y) => (
          <li class="cluster justify-between">
            {row.media.map((item, x) => (
              item._type === "video" ? (
                <Video
                  transition-name={y === 0 && x === 0 ? `${project.slug.current}-0` : undefined}
                  video={item}
                />
              ) : (
                <Image
                  transition-name={y === 0 && x === 0 ? `${project.slug.current}-0` : undefined}
                  image={item}
                  width={640}
                  widths={[320, 640, 800, 960, 1280, 1600]}
                  sizes={`(max-width: 720px) ${Math.floor(100 / row.media.length)}vw, calc((100vw - 90px) * 5 / 7 / ${row.media.length})`}
                  fetchpriority={y === 0 ? 'high' : null}
                />
              )
            ))}
          </li>
        ))}
      </ul>
    </main>
    <footer class="cluster justify-between">
      {nextProject && (
        <Card>
          <Image
            slot="image"
            image={nextProject.image}
            width={640}
            widths={CARD_IMAGE_WIDTHS}
            sizes={CARD_IMAGE_SIZES}
          />
          <Fragment slot="body">
            <a href={`/projects/${nextProject.slug.current}`}>{nextProject.title}</a>
            <span>{nextProject.subtitle}</span>
          </Fragment>
        </Card>
      )}
      {previousProject && (
        <Card class="ml-auto">
          <Image
            slot="image"
            image={previousProject.image}
            width={640}
            widths={CARD_IMAGE_WIDTHS}
            sizes={CARD_IMAGE_SIZES}
          />
          <Fragment slot="body">
            <a href={`/projects/${previousProject.slug.current}`}>{previousProject.title}</a>
            <span>{previousProject.subtitle}</span>
          </Fragment>
        </Card>
      )}
    </footer>
  </article>
</Layout>
<script>
import * as stores from "@/lib/stores";

const COMPONENT_QUERY = '[data-component="project"]';

const store = stores.slider("/");

const mounted = () => {
  [...document.querySelectorAll(COMPONENT_QUERY)].forEach((component) => {
    if (!(component instanceof HTMLElement)) return;
    const slug = component.dataset.slug;
    if (!slug) return;
    store.set("slug", slug);
  });
};

mounted();

document.addEventListener("astro:after-swap", mounted);
</script>
