---
import Close from "@/assets/close.svg";
import Card from "@/components/Card.astro";
import Image from "@/components/Image.astro";
import PortableText from "@/components/PortableText.astro";
import Layout from "@/layouts/Layout.astro";
import * as contents from "@/lib/contents";

const CARD_IMAGE_WIDTHS = [320, 640, 800, 960, 1280, 1600];
const CARD_IMAGE_SIZES =
  "(max-width: 720px) 100vw, (max-width: 960px) 50vw, (max-width: 1280px) 33vw, 25vw";

export async function getStaticPaths() {
  const { result: projects } = await contents.getProjects();

  return projects.map(({ slug }) => {
    return {
      params: {
        slug: slug.current,
      },
    };
  });
}

const { params } = Astro;

const { result: project } = await contents.getProject(params.slug);
const { result: previousProject } = await contents.getPreviousProject(
  project._id,
);
const { result: nextProject } = await contents.getNextProject(project._id);
---

<Layout
  title={project.title}
  image={project.image}
>
  <article
    class="project"
    data-slug={project.slug.current}
    data-component="project"
  >
    <aside>
      <header class="stack stack-sm">
        <h1>{project.title}</h1>
        <span>{project.subtitle}</span>
      </header>
      <div>
        <PortableText portableText={project.content} />
      </div>
    </aside>
    <main>
      <ul class="stack">
        {project.rows.map((row, y) => (
          <li class="cluster justify-between">
            {row.images.map((image, x) => (
              <button class="zoom-in" type="button" command="show-modal" commandfor="lightbox">
                <Image
                  transition-name={y === 0 && x === 0 ? `${project.slug.current}-0` : undefined}
                  image={image}
                  width={640}
                  widths={[320, 640, 800, 960, 1280, 1600]}
                  sizes={`(max-width: 720px) ${Math.floor(100 / row.images.length)}vw, calc((100vw - 90px) * 5 / 7 / ${row.images.length})`}
                  fetchpriority={y === 0 ? 'high' : null}
                />
              </button>
            ))}
          </li>
        ))}
      </ul>
    </main>
    <footer class="cluster justify-between">
      {nextProject && (
        <Card>
          <Image
            slot="image"
            transition-name={`${nextProject.slug.current}-0`}
            image={nextProject.image}
            width={640}
            widths={CARD_IMAGE_WIDTHS}
            sizes={CARD_IMAGE_SIZES}
          />
          <Fragment slot="body">
            <a href={`/projects/${nextProject.slug.current}`}>{nextProject.title}</a>
            <span>{nextProject.subtitle}</span>
          </Fragment>
        </Card>
      )}
      {previousProject && (
        <Card class="ml-auto">
          <Image
            slot="image"
            transition-name={`${previousProject.slug.current}-0`}
            image={previousProject.image}
            width={640}
            widths={CARD_IMAGE_WIDTHS}
            sizes={CARD_IMAGE_SIZES}
          />
          <Fragment slot="body">
            <a href={`/projects/${previousProject.slug.current}`}>{previousProject.title}</a>
            <span>{previousProject.subtitle}</span>
          </Fragment>
        </Card>
      )}
    </footer>
  </article>
  <dialog
    id="lightbox"
    class="lightbox"
    closedby="any"
    slot="portal"
  >
    <header>
      <button
        type="button"
        autofocus
        command="close"
        commandfor="lightbox"
        aria-label="Close lightbox"
      >
        <span class="icon">
          <Close />
        </span>
      </button>
    </header>
    <img
      loading="lazy"
      alt="placeholder"
    >
  </dialog>
</Layout>
<script>
import * as stores from "@/lib/stores";

const COMPONENT_QUERY = '[data-component="project"]';
const LIGHTBOX_QUERY = "#lightbox";
const LIGHTBOX_IMAGE_QUERY = "#lightbox img";
const LIGHTBOX_CLOSE_QUERY = "#lightbox button";
const LIGHTBOX_TRIGGER_QUERY = 'button[commandfor="lightbox"]';

const store = stores.slider("/");
const subscriptions: Array<() => void> = [];

const mounted = () => {
  [...document.querySelectorAll(COMPONENT_QUERY)].forEach((component) => {
    if (!(component instanceof HTMLElement)) return;
    const slug = component.dataset.slug;
    if (!slug) return;
    store.set("slug", slug);
  });
  [...document.querySelectorAll(LIGHTBOX_TRIGGER_QUERY)].forEach((trigger) => {
    if (!(trigger instanceof HTMLElement)) return;
    trigger.addEventListener("click", handleLightboxTrigger);
    subscriptions.push(() => {
      trigger.removeEventListener("click", handleLightboxTrigger);
    });
  });
  [...document.querySelectorAll(LIGHTBOX_QUERY)].forEach((lightbox) => {
    if (!(lightbox instanceof HTMLElement)) return;
    lightbox.addEventListener("close", handleLightboxClose);
    subscriptions.push(() => {
      lightbox.removeEventListener("close", handleLightboxClose);
    });
  });
  [...document.querySelectorAll(LIGHTBOX_IMAGE_QUERY)].forEach((image) => {
    if (!(image instanceof HTMLElement)) return;
    image.addEventListener("click", handleLightboxToggleZoom);
    subscriptions.push(() => {
      image.removeEventListener("click", handleLightboxToggleZoom);
    });
  });
};
const destroyed = () => {
  subscriptions.forEach((subscription) => {
    subscription();
  });
  subscriptions.splice(0, -1);
};

const handleLightboxToggleZoom = (event: PointerEvent) => {
  const trigger = event.currentTarget;
  if (!(trigger instanceof HTMLElement)) return;
  const lightbox = trigger.closest("dialog");
  if (!(lightbox instanceof HTMLElement)) return;
  const rect = trigger.getBoundingClientRect();

  lightbox.classList.toggle("zoomed-in");

  if (lightbox.classList.contains("zoomed-in")) {
    const ratioX = (event.offsetX - rect.left) / rect.width;
    const ratioY = (event.offsetY - rect.top) / rect.height;
    lightbox.scrollLeft =
      lightbox.scrollWidth * ratioX - lightbox.clientWidth / 2;
    lightbox.scrollTop =
      lightbox.scrollHeight * ratioY - lightbox.clientHeight / 2;
  } else {
    lightbox.scrollLeft = 0;
    lightbox.scrollTop = 0;
  }
};

const handleLightboxClose = (event: Event) => {
  const lightbox = event.target;
  if (!(lightbox instanceof HTMLDialogElement)) return;
  lightbox.classList.remove("zoomed-in");
};

const handleLightboxTrigger = (event: PointerEvent) => {
  const trigger = event.currentTarget;
  if (!(trigger instanceof HTMLElement)) return;
  const target = document.querySelector(LIGHTBOX_IMAGE_QUERY);
  if (!(target instanceof HTMLImageElement)) return;
  const image = trigger.querySelector("img[data-original-src]");
  if (!(image instanceof HTMLElement)) return;
  if (image.dataset.originalSrc) target.src = image.dataset.originalSrc;
  const height = parseInt(image.dataset.originalHeight ?? "", 10);
  if (Number.isFinite(height)) target.height = height;
  const width = parseInt(image.dataset.originalWidth ?? "", 10);
  if (Number.isFinite(width)) target.width = width;
  target.style.aspectRatio = image.style.aspectRatio;
};

mounted();

document.addEventListener("astro:before-swap", destroyed);
document.addEventListener("astro:after-swap", mounted);
</script>
